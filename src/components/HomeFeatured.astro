<style>
	
	a {
		text-decoration: none;
		margin-bottom: 1rem;
		display: block;
		article {
			.thumb {
				height: 100%;
				min-height: 300px;
				background-color: #000;
				overflow: hidden;
				position: relative;
				img {
					position: absolute;
					left: 50%;
					top: 50%;
					transform: translate(-50%, -50%);
					object-fit: cover;
					width: 100%;
					height: 100%;
					object-position: center top; 
				}
			}
			.copy {
				padding: 1rem;
				vertical-align: middle;
                background: #FFF;
			}
			h1 {
				font-size: 2rem;
				color: #000;
				margin: 0 0 .5rem;
				padding: 0;
				line-height: 120%;
			}
			.byline {
				text-transform: uppercase;
				font-size: 0.8rem;
				margin: 0.5rem 0;
				opacity: .5;
			}
			.description {
				font-size: 1rem;
				margin: 0;
				padding: 0;
				line-height: 150%;
			}
		}
	}
</style>
