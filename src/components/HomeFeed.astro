---
import type { ArticleSummary } from "../lib/articles";

interface Props {
	posts: ArticleSummary[];
	currentPage?: number;
	totalPages?: number;
}

const { posts, currentPage = 1, totalPages = 1 } = Astro.props;
---

<section id="home-feed">
	{
		posts.map((post) => (
			<a href={`/articles/${post.year}/${post.slug}/`}>
				<article>
					<div class="copy">
						<h1>{post.title}</h1>
						<p class="description">{post.description}</p>
						<p class="byline">By: {post.authorNames.join(", ")}</p>
					</div>
				</article>
			</a>
		))
	}

	{
		totalPages > 1 && (
			<nav class="pagination" aria-label="Post pages">
				{currentPage > 1 && (
					<a href={currentPage === 2 ? "/" : `/page/${currentPage - 1}/`}>
						Previous
					</a>
				)}
				<span>
					Page {currentPage} of {totalPages}
				</span>
				{currentPage < totalPages && (
					<a href={`/page/${currentPage + 1}/`}>Next</a>
				)}
			</nav>
		)
	}
</section>

<style>
	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin: 1.5rem 0;
		font-size: 0.9rem;
		text-transform: uppercase;
	}
	.pagination span {
		opacity: 0.6;
	}
	a {
		text-decoration: none;
		margin-bottom: 1rem;
		display: block;
		transition: all 0.5s;
		&:hover {
			transform: scale(1.004);
			box-shadow: 5px 5px 15px 4px rgba(0, 0, 0, 0.17);
		}
		article {
			background: var(--color-highlight);
			.copy {
				padding: 1rem;
				text-wrap: pretty;
			}
			h1 {
				font-size: 1.2rem;
				color: #fff;
				margin: 0 0 0.5rem;
				padding: 0;
				line-height: 120%;
				font-weight: normal;
			}
			.byline {
				text-transform: uppercase;
				font-size: 0.8rem;
				margin: 0.5rem 0;
				color: var(--color-background);
				opacity: 0.5;
			}
			.description {
				color: var(--color-background);
				font-size: 0.9rem;
				margin: 0;
				padding: 0;
				line-height: 150%;
			}
		}
	}
</style>
