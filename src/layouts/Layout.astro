---
interface Author {
  name?: string;
  fields?: {
    name?: string;
  };
}

interface Props {
	frontmatter?: {
		title?: string;
		description?: string;
		bodyTags?: []
	};
	pageTitle?: string;
	pageDescription?: string;
	authors?: Author[];
	bodyTags?: []
}

import { ClientRouter } from "astro:transitions";

import "../styles/general.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { undefined } from "astro:schema";


const { frontmatter } = Astro.props;

const title =
	frontmatter?.title ?? Astro.props.pageTitle ?? "Lewton Bus: writing on movies, &c.";
const description =
	frontmatter?.description ??
	Astro.props.pageDescription ??
	"We're back, and better than ever. Or at least as good. We're okay.";
const bodyTags =
	frontmatter?.bodyTags ??
	Astro.props.bodyTags ?? undefined;
console.log(bodyTags);
---

<!doctype html>
<html lang="en">
	<head>
		<meta name="description" content={description} />
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&family=Space+Grotesk:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class:list={bodyTags}>
		<Header title={title} />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
